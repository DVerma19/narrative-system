{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://narrative-os.example.com/schemas/state.json",
    "title": "Narrative OS State Document",
    "description": "The single source of truth for a story session.",
    "type": "object",
    "required": [
        "story_id",
        "title",
        "chapter",
        "genre_profile",
        "characters",
        "relationships",
        "event_ledger",
        "promises",
        "ripples",
        "locations",
        "memory_pack",
        "chapters_written"
    ],
    "properties": {
        "story_id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the story session."
        },
        "title": {
            "type": "string",
            "description": "Working title of the story."
        },
        "chapter": {
            "type": "integer",
            "minimum": 0,
            "description": "Current chapter number (0 = not yet started)."
        },
        "genre_profile": {
            "$ref": "#/definitions/genre_profile"
        },
        "characters": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/definitions/character"
            },
            "description": "Map of character key (e.g., 'harry') to character record."
        },
        "relationships": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/definitions/relationship"
            },
            "description": "Map of relationship pair key (e.g., 'harry_hermione') to relationship record."
        },
        "event_ledger": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/event"
            },
            "description": "Chronological list of all significant story events."
        },
        "promises": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/promise"
            },
            "description": "All unresolved and recently resolved plot promises."
        },
        "ripples": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/ripple"
            },
            "description": "Pending delayed consequences."
        },
        "locations": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/definitions/location"
            },
            "description": "Map of location name to location record."
        },
        "memory_pack": {
            "$ref": "#/definitions/memory_pack"
        },
        "chapters_written": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Full prose text of each completed chapter, in order."
        }
    },
    "definitions": {
        "genre_profile": {
            "type": "object",
            "required": [
                "genre",
                "tone",
                "content_rating",
                "pacing",
                "style_notes"
            ],
            "properties": {
                "genre": {
                    "type": "string",
                    "description": "Primary genre: romance, thriller, dark fantasy, literary fiction, horror, fanfiction, etc."
                },
                "tone": {
                    "type": "string",
                    "description": "Descriptive tone guidance: e.g., 'warm and intimate', 'gritty and tense', 'wry and humorous'."
                },
                "content_rating": {
                    "type": "string",
                    "enum": [
                        "teen",
                        "mature",
                        "adult"
                    ],
                    "description": "Controls explicitness of violence, language, and sexual content."
                },
                "pacing": {
                    "type": "string",
                    "enum": [
                        "slow-burn",
                        "medium",
                        "fast"
                    ],
                    "description": "How quickly promises resolve and relationships advance."
                },
                "style_notes": {
                    "type": "string",
                    "description": "Freeform style guidance injected into prompts: POV, tense, prose density, etc."
                },
                "world_rules": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Hard facts the Continuity Validator checks against."
                },
                "source_material": {
                    "type": "string",
                    "description": "If fanfiction, the original work (e.g., 'Harry Potter by J.K. Rowling')."
                },
                "canon_departure_point": {
                    "type": "string",
                    "description": "Where the story diverges from canon."
                },
                "canon_facts_retained": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Canon elements that remain true."
                },
                "canon_facts_changed": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Canon elements deliberately altered."
                },
                "beat_weighting": {
                    "type": "object",
                    "description": "Optional manual override for beat emphasis.",
                    "properties": {
                        "heavy_beats": {
                            "type": "array",
                            "items": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 7
                            }
                        },
                        "light_beats": {
                            "type": "array",
                            "items": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 7
                            }
                        }
                    }
                }
            }
        },
        "character": {
            "type": "object",
            "required": [
                "full_name",
                "age",
                "emotional_state",
                "location",
                "physical_description",
                "current_appearance",
                "physical_state",
                "key_possessions",
                "abilities",
                "trigger_list"
            ],
            "properties": {
                "full_name": {
                    "type": "string"
                },
                "age": {
                    "type": "integer",
                    "minimum": 0
                },
                "identity": {
                    "type": "string",
                    "description": "Brief identity markers."
                },
                "emotional_state": {
                    "type": "string"
                },
                "hidden_feelings": {
                    "type": "string"
                },
                "location": {
                    "type": "string",
                    "description": "Must match a key in 'locations'."
                },
                "physical_description": {
                    "type": "object",
                    "required": [
                        "height",
                        "build",
                        "hair_color",
                        "eye_color",
                        "skin_tone"
                    ],
                    "properties": {
                        "height": {
                            "type": "string"
                        },
                        "build": {
                            "type": "string"
                        },
                        "hair_color": {
                            "type": "string"
                        },
                        "eye_color": {
                            "type": "string"
                        },
                        "skin_tone": {
                            "type": "string"
                        },
                        "distinguishing_features": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "typical_clothing": {
                            "type": "string"
                        }
                    }
                },
                "current_appearance": {
                    "type": "object",
                    "required": [
                        "clothing"
                    ],
                    "properties": {
                        "clothing": {
                            "type": "string",
                            "description": "Use 'none' or 'unclothed' for nudity."
                        },
                        "injuries_visible": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "grooming_notes": {
                            "type": "string"
                        }
                    }
                },
                "physical_state": {
                    "type": "string"
                },
                "key_possessions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "abilities": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "last_action": {
                    "type": "string"
                },
                "trigger_list": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "relationship": {
            "type": "object",
            "required": [
                "stage",
                "trust",
                "attraction",
                "tension",
                "comfort",
                "history"
            ],
            "properties": {
                "stage": {
                    "type": "string",
                    "enum": [
                        "Strangers",
                        "Acquaintances",
                        "Friends",
                        "Close Friends",
                        "Romantic Tension",
                        "Dating",
                        "Betrothed",
                        "Bonded",
                        "Married",
                        "Enemies",
                        "Rivals",
                        "Companions",
                        "Allies",
                        "Mentor/Protege",
                        "Family",
                        "Exes"
                    ],
                    "description": "Current relationship stage."
                },
                "trust": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10
                },
                "attraction": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10
                },
                "tension": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10
                },
                "comfort": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10
                },
                "history": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Log of dimension changes with chapter prefix."
                },
                "notes": {
                    "type": "string",
                    "description": "Optional contextual notes."
                }
            }
        },
        "event": {
            "type": "object",
            "required": [
                "event_id",
                "chapter",
                "type",
                "initiator",
                "participants",
                "location",
                "summary",
                "state_changes",
                "relationship_changes",
                "promises_created",
                "promises_resolved",
                "causal_links"
            ],
            "properties": {
                "event_id": {
                    "type": "string",
                    "pattern": "^E-\\d{3}$"
                },
                "chapter": {
                    "type": "integer",
                    "minimum": 1
                },
                "type": {
                    "type": "string"
                },
                "initiator": {
                    "type": "string"
                },
                "participants": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "location": {
                    "type": "string"
                },
                "summary": {
                    "type": "string"
                },
                "state_changes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "relationship_changes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "promises_created": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "promises_resolved": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "causal_links": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "type",
                            "target_event_id",
                            "description"
                        ],
                        "properties": {
                            "type": {
                                "type": "string",
                                "enum": [
                                    "Causes",
                                    "Enables",
                                    "Prevents",
                                    "Motivates"
                                ]
                            },
                            "target_event_id": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "promise": {
            "type": "object",
            "required": [
                "promise_id",
                "type",
                "description",
                "setup_event",
                "status",
                "priority",
                "created_chapter"
            ],
            "properties": {
                "promise_id": {
                    "type": "string",
                    "pattern": "^P-\\d{3}$"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "prophecy",
                        "secret",
                        "revenge",
                        "confession",
                        "return",
                        "mystery",
                        "threat",
                        "oath",
                        "mission",
                        "romance"
                    ]
                },
                "description": {
                    "type": "string"
                },
                "setup_event": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "Pending",
                        "In Progress",
                        "Resolved",
                        "Abandoned"
                    ]
                },
                "priority": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                },
                "created_chapter": {
                    "type": "integer"
                },
                "planned_resolution": {
                    "type": "string"
                },
                "resolved_chapter": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "resolution_event": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "ripple": {
            "type": "object",
            "required": [
                "ripple_id",
                "source_event",
                "source_chapter",
                "condition",
                "effect",
                "priority",
                "status"
            ],
            "properties": {
                "ripple_id": {
                    "type": "string",
                    "pattern": "^R-\\d{3}$"
                },
                "source_event": {
                    "type": "string"
                },
                "source_chapter": {
                    "type": "integer"
                },
                "target_character": {
                    "type": "string"
                },
                "condition": {
                    "type": "string",
                    "description": "What must happen for this ripple to trigger."
                },
                "effect": {
                    "type": "string",
                    "description": "What happens when triggered."
                },
                "priority": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                },
                "expires_chapter": {
                    "type": [
                        "integer",
                        "null"
                    ]
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "Pending",
                        "Triggered",
                        "Expired"
                    ]
                }
            }
        },
        "location": {
            "type": "object",
            "required": [
                "name",
                "current_occupants",
                "state"
            ],
            "properties": {
                "name": {
                    "type": "string"
                },
                "current_occupants": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "active_wards": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "known_secrets": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "state": {
                    "type": "string",
                    "enum": [
                        "pristine",
                        "damaged",
                        "destroyed",
                        "abandoned",
                        "under siege"
                    ]
                },
                "last_visited_chapter": {
                    "type": "integer"
                }
            }
        },
        "memory_pack": {
            "type": "object",
            "required": [
                "last_chapter_summary",
                "active_promises",
                "relationship_snapshot",
                "emotional_states",
                "pending_ripples",
                "unresolved_conflicts"
            ],
            "properties": {
                "last_chapter_summary": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "minItems": 3,
                    "maxItems": 5
                },
                "active_promises": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "id",
                            "desc",
                            "priority",
                            "status"
                        ],
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "desc": {
                                "type": "string"
                            },
                            "priority": {
                                "type": "integer"
                            },
                            "status": {
                                "type": "string"
                            }
                        }
                    }
                },
                "relationship_snapshot": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "object",
                        "required": [
                            "stage",
                            "trust",
                            "attraction",
                            "tension",
                            "comfort"
                        ],
                        "properties": {
                            "stage": {
                                "type": "string"
                            },
                            "trust": {
                                "type": "integer"
                            },
                            "attraction": {
                                "type": "integer"
                            },
                            "tension": {
                                "type": "integer"
                            },
                            "comfort": {
                                "type": "integer"
                            }
                        }
                    }
                },
                "emotional_states": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "pending_ripples": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "id",
                            "effect"
                        ],
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "effect": {
                                "type": "string"
                            }
                        }
                    }
                },
                "unresolved_conflicts": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    }
}